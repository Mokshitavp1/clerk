# Local Ollama Server Configuration (100% On-Premise / Sovereign Execution)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
OLLAMA_EMBED_MODEL="bge-m3"

# PRD Section 7.1 Timeout Budgets (in seconds)
OLLAMA_SUMMARY_TIMEOUT_SECONDS="60"
OLLAMA_QUERY_TIMEOUT_SECONDS="120"
OLLAMA_VERIFIER_TIMEOUT_SECONDS="120"

# Optional Cross-Encoder Reranker (BAAI/bge-reranker-v2-m3)
CLERK_ENABLE_RERANK="0"
